# 루트 .env 로 복사해서 값 변경:  cp .env.example .env
# (.env 는 git 에 올라가지 않음)

# --- DB ---
DB_NAME=sool
DB_USER=sool
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- 인증 ---
# 생성: openssl rand -hex 32
SECRET_KEY=change-me
# https 로 공개할 때 true
COOKIE_SECURE=false

# --- 포트 ---
# 프론트를 열 주소. Docker 는 ufw 를 우회하므로 0.0.0.0 대신 필요한 주소만 지정한다.
#   127.0.0.1      : 이 컴퓨터에서만 (기본값, 맥 개발)
#   100.125.79.96  : 서버의 Tailscale IP → tailnet 기기에서만 접속 (현재 운영)
#   0.0.0.0        : 모든 인터페이스 (도메인/HTTPS 공개 단계에서 리버스 프록시 뒤일 때만)
# 주의: 지정한 IP 가 없는 상태(부팅 직후 tailscale 미기동 등)면 컨테이너 시작이 실패한다.
FRONT_BIND=127.0.0.1
FRONT_PORT=3300
