# 루트 .env 로 복사해서 값 변경:  cp .env.example .env
# (.env 는 git 에 올라가지 않음)

# --- DB ---
DB_NAME=sool
DB_USER=sool
DB_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# --- 인증 ---
# 생성: openssl rand -hex 32
SECRET_KEY=change-me
# https 로 공개할 때 true
COOKIE_SECURE=false

# --- 포트 ---
FRONT_PORT=3300
